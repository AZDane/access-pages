# Build the pinned CLI source with the narrowly scoped Access Pages patch.
FROM --platform=$BUILDPLATFORM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS qurl
ENV GOTOOLCHAIN=go1.26.9 CGO_ENABLED=0
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl patch \
    && curl -fsSL https://codeload.github.com/layervai/qurl-integrations/tar.gz/3da4ba34df029c31e86dc2ed00997d015b1bac8d -o /tmp/qurl-source.tar.gz \
    && printf '%s  /tmp/qurl-source.tar.gz\n' 1741ed95a34c5665849d492b94d9dc1798f0379f1cfaefbf1e601f29a72db318 | sha256sum -c - \
    && tar -xzf /tmp/qurl-source.tar.gz --strip-components=1 -C /src
COPY packaging/qurl/access-pages.diff /tmp/access-pages.diff
COPY packaging/qurl/access_pages_publish*.go /src/apps/cli/cmd/
RUN patch --batch --fuzz=0 -p1 < /tmp/access-pages.diff \
    && go test ./apps/cli/cmd -run 'TestAccessPages|TestLocalPublish|TestPublishIsPrivateUnlessPublic' -count=1
ARG TARGETARCH
# The hub key is the public trust anchor embedded in the official 3.5.0 binary.
RUN GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -buildvcs=false \
    -ldflags='-s -w -X main.version=3.5.0-access-pages.1 -X github.com/layervai/qurl-integrations/apps/cli/internal/connector/hub.defaultServerPublicKeyB64=LxWWlFQ18yEgSl0lDX1+cMhCLLEc8LkHTOc1QskRY28=' \
    -o /out/qurl ./apps/cli/cmd

FROM --platform=$BUILDPLATFORM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS guest-endpoint
WORKDIR /src
COPY go.mod ./
COPY cmd/guest-endpoint ./cmd/guest-endpoint
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/access-pages-guest-endpoint ./cmd/guest-endpoint

FROM python:3.15-slim-bookworm@sha256:2a41267d9de9d358f77a1de356e0f16ecba8d39827855be0ce9ef4792edce402

# Apply Debian's PCRE2 and Perl security fixes to the pinned base.
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade libpcre2-8-0 perl-base \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge 10.42-1+deb12u2 \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge 5.36.0-7+deb12u4 \
    && rm -rf /var/lib/apt/lists/*

# The application uses only the standard library. Remove package installers and
# their vendored dependencies from the runtime, including ensurepip's wheels.
RUN python -m pip uninstall --yes pip \
    && python -c 'import pathlib, shutil, sysconfig; shutil.rmtree(pathlib.Path(sysconfig.get_path("stdlib")) / "ensurepip")'

# qURL verifies tunnel TLS against the system trust store. The pinned Python
# base supplies ca-certificates; fail the build if that runtime contract changes.
RUN dpkg-query -W ca-certificates \
    && test -s /etc/ssl/certs/ca-certificates.crt \
    && python -c 'import ssl; assert ssl.create_default_context().cert_store_stats()["x509_ca"] > 0'

ARG BUILD_ARCH
ARG BUILD_VERSION=0.1.141

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    GATEWAY_VERSION=${BUILD_VERSION}

LABEL \
    io.hass.arch="${BUILD_ARCH}" \
    io.hass.type="app" \
    io.hass.version="${BUILD_VERSION}" \
    org.opencontainers.image.source="https://github.com/AZDane/access-pages" \
    org.opencontainers.image.version="${BUILD_VERSION}"

WORKDIR /app

COPY server.py actions.py admin.py access.py upstream_cleanup.py guest_resources.py guest_service.py guest_diagnostics.py guest_request.py internal.py config.py ha.py ha_broker.py pages.py layerv.py layerv_broker.py policy.py policy_store.py audit.py activity.py rate_limit.py email_delivery.py verification.py ./
COPY static ./static
COPY themes.py ./
COPY LICENSE THIRD_PARTY_NOTICES.md ./
COPY third_party_licenses ./third_party_licenses
COPY packaging/qurl ./third_party_licenses/access-pages-qurl-compatibility
COPY homeassistant-app/app_runner.py /usr/local/bin/app_runner.py
COPY homeassistant-app/ingress_proxy.py /usr/local/bin/ingress_proxy.py
COPY homeassistant-app/onboarding.py /usr/local/bin/onboarding.py
COPY --from=qurl /out/qurl /usr/local/bin/qurl
COPY --from=guest-endpoint /out/access-pages-guest-endpoint /usr/local/bin/access-pages-guest-endpoint

RUN mkdir -p /data/pages /data/secrets /data/connector-state \
        /data/connector-config /data/logs /data/policy-pages \
        /data/guest-runtime /data/admin-runtime /data/access-pages-broker \
    && groupadd --gid 2000 gateway-pages \
    && groupadd --gid 2001 policy-readers \
    && groupadd --gid 2003 access-pages-secrets \
    && groupadd --gid 2004 guest-transport \
    && useradd --uid 2100 --user-group --create-home --shell /usr/sbin/nologin app-admin \
    && useradd --uid 2101 --user-group --create-home --shell /usr/sbin/nologin app-guest \
    && useradd --uid 2102 --user-group --create-home --shell /usr/sbin/nologin ha-broker \
    && useradd --uid 2103 --user-group --create-home --shell /usr/sbin/nologin access-pages-broker \
    && useradd --uid 2104 --user-group --create-home --shell /usr/sbin/nologin policy-store \
    && useradd --uid 2105 --user-group --create-home --shell /usr/sbin/nologin connector \
    && useradd --uid 2106 --user-group --create-home --shell /usr/sbin/nologin ingress \
    && useradd --uid 2107 --user-group --create-home --shell /usr/sbin/nologin onboarding \
    && chown app-admin:gateway-pages /data/pages \
    && chmod 2750 /data/pages \
    && chown app-admin:app-admin /data/admin-runtime \
    && chmod 0700 /data/admin-runtime \
    && chown policy-store:policy-readers /data/policy-pages \
    && chmod 2750 /data/policy-pages \
    && chown app-admin:app-admin /data/guest-runtime \
    && chmod 0700 /data/guest-runtime \
    && chown root:access-pages-secrets /data/secrets \
    && chmod 0750 /data/secrets \
    && chown connector:connector /data/connector-state /data/connector-config \
    && mkdir -p /data/logs/layer-v-connector \
    && chown connector:connector /data/logs/layer-v-connector \
    && chmod 0700 /data/connector-state /data/connector-config /data/logs/layer-v-connector \
    && ln -s /data/logs/layer-v-connector /var/log/layerv

EXPOSE 8080 8099

STOPSIGNAL SIGTERM

CMD ["python", "/usr/local/bin/app_runner.py"]
